{
  "Name": "Hellocontest OpenAction Plugin",
  "Author": "ftl",
  "Version": "0.0.0-dev",
  "Icon": "icons/category",
  "Category": "Hello Contest",
  "CategoryIcon": "icons/category",
  "PropertyInspectorPath": "pi/empty.html",
  "HasSettingsInterface": false,
  "Actions": [
    {
      "Name": "Do Action",
      "UUID": "com.thecodingflow.hcplugin.doaction",
      "Tooltip": "Trigger a hellocontest action by ID.",
      "Icon": "icons/keypad",
      "DisableAutomaticStates": false,
      "VisibleInActionsList": true,
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/doaction.html",
      "Controllers": ["Keypad", "Encoder"],
      "States": [{ "Title": "Do Action" }]
    },
    {
      "Name": "Send Text",
      "UUID": "com.thecodingflow.hcplugin.sendtext",
      "Tooltip": "Send a Morse text through hellocontest's keyer.",
      "Icon": "icons/keypad",
      "DisableAutomaticStates": false,
      "VisibleInActionsList": true,
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/sendtext.html",
      "Controllers": ["Keypad", "Encoder"],
      "States": [{ "Title": "Send Text" }]
    },
    {
      "Name": "Search & Pounce",
      "UUID": "com.thecodingflow.hcplugin.searchpounce",
      "Tooltip": "Encoder: rotate to navigate band-map spots, press for next ESM step.",
      "Icon": "icons/encoder",
      "DisableAutomaticStates": false,
      "VisibleInActionsList": true,
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/empty.html",
      "Controllers": ["Encoder"],
      "States": [{ "Title": "S&P" }]
    }
  ],
  "OS": [{ "Platform": "linux" }],
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "hcplugin-x86_64-unknown-linux-gnu"
  },
  "CodePathLin": "hcplugin-x86_64-unknown-linux-gnu"
}
